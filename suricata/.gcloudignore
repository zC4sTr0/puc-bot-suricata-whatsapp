# O upload para Cloud Build segue as mesmas fronteiras do Docker.
.gcloudignore
.git/

# Dependências e metadados locais
whatsapp/node_modules/
**/node_modules/
**/__pycache__/
*.pyc
.env
.env.*

# Segredos, autenticação e sessões
auth.json
**/auth.json
.wa-auth*/
**/.wa-auth*/
**/auth/
**/session/
**/sessions/
**/*session*/
**/auth_info_baileys/
**/logs/

# Estado, chaves, QR e temporários
*.log
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.pem
*.key
*.qr
*qr*.png
qr*.txt
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
grupos.json
**/grupos.json
