# Variáveis de ambiente da Suricata.
# Copie para `.env` (fora do versionamento) apenas se o runtime que você usa
# ler esse arquivo; valores reais ficam em Secret Manager em produção.

# Obrigatória para `rodada`. Token de acesso à API do Canvas.
# Nunca imprima, versione ou passe por argv.
SURICATA_CANVAS_TOKEN=cole-o-token-via-secret-manager

# Obrigatória para caminhos com estado (`rodada`, `grupos`).
# Aceita um diretório local OU um prefixo `gs://...` (GCS).
# Ausente, o runtime falha fechado nos caminhos que dependem de estado.
SURICATA_ESTADO_URI=./estado-local

# Entrega: desligada por padrão. O valor exato `ligada` habilita o envio na
# rodada e exige autorização explícita do titular; qualquer outro valor
# mantém a entrega desligada.
SURICATA_ENTREGA=desligada

# Opcional. Destino legado: JID de grupo do WhatsApp (termina em @g.us).
# Validado com regex; inválido faz o runtime falhar fechado.
SURICATA_GRUPO_JID=000000000000-0000000000@g.us

# Opcional. Destinos adicionais em JSON: lista de objetos
# {"id": "...", "jid": "...", "janela_brt": "HH:MM"} (janela opcional).
# `id` só pode formar um segmento de caminho seguro; memória e outbox ficam
# namespaced por destino. Alternativa legada: SURICATA_DESTINOS.
SURICATA_DESTINOS_JSON=[{"id":"exemplo","jid":"000000000000-0000000000@g.us"}]

# Opcional. Config de destinos por ARQUIVO (alternativa a colar JSON no env).
# O arquivo tem o formato:
#   {"destinos": [{"id": "exemplo", "jid": "...@g.us", "janela_brt": "22:00"}],
#    "lease_minutos": 6}
# Os destinos do arquivo são a base; se SURICATA_GRUPO_JID/SURICATA_DESTINOS_JSON
# também estiverem definidos no ambiente, eles SOBREPOÕEM o arquivo (env > arquivo).
# Arquivo ausente ou inválido faz o runtime falhar fechado. Nota: `lease_minutos`
# do arquivo é aceito mas não aplicado — o lease continua lido de
# SURICATA_LEASE_MINUTOS no ambiente.
# SURICATA_CONFIG=/caminho/fora/do/repositorio/suricata-config.json

# Opcional. Duração do lease da rodada, em minutos. Padrão: 6.
# O valor é convertido para inteiro no import de lease_rodada; texto não
# numérico, zero ou valores negativos fazem o runtime falhar fechado.
SURICATA_LEASE_MINUTOS=6

# Opcional. IDs de ofertas Canvas que não devem ser coletadas, separados por
# vírgula. Cada ID deve ser numérico e não pode se repetir. Se ausente, o
# runtime usa o padrão legado 104959; valor vazio é inválido.
SURICATA_CURSOS_EXCLUIDOS=104959

# Opcional. URI explícita do objeto de sessão no GCS. Na rodada, se ausente,
# a sessão usa whatsapp/auth.json dentro do namespace de SURICATA_ESTADO_URI.
# Quando presente, deve ser exatamente gs://<bucket>/<prefixo>/whatsapp/auth.json
# desse namespace; nunca use outro bucket/produto. Não é usada para escolher
# o diretório temporário que a ponte Python passa ao processo Node.
# SURICATA_WA_SESSION_OBJECT=gs://bucket/prefixo/whatsapp/auth.json

# Opcional para comandos Node diretos (enviar/verificar). O pareamento recebe
# o diretório por --auth-dir. A ponte Python da rodada materializa a sessão em
# diretório temporário e passa auth_dir pelo stdin, portanto não lê esta
# variável. Mantenha o diretório fora do repositório; o adaptador rejeita
# caminhos dentro do clone.
# SURICATA_WA_AUTH_DIR=/caminho/fora/do/repositorio/.wa-auth
